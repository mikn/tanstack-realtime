{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "@tanstack/react-query",
        "@tanstack/react-db",
        "@realtimejs/react",
        "@realtimejs/react-devtools",
        "@tanstack/react-store",
        "react"
      ],
      "ignoreBinaries": ["pkg-pr-new"]
    },
    "packages/core": {},
    "packages/react": {},
    "packages/react-devtools": {},
    "packages/adapter-centrifugo": {},
    "packages/adapter-sse": {},
    "packages/__tests__": {
      "entry": ["**/*.test.ts"],
      "ignore": ["setup.ts"]
    },
    "packages/preset-start": {},
    "packages/reactive-drizzle": {},
    "packages/meta": {},
    "packages/e2e": {
      "entry": [
        "app/vite.config.ts",
        "app/app/client.tsx",
        "app/app/router.tsx",
        "app/app/routeTree.gen.ts",
        "app/app/routes/**/*.{ts,tsx}",
        "app-solid/vite.config.ts",
        "app-solid/src/main.tsx",
        "app-solid/src/**/*.{ts,tsx}",
        "app-vue/vite.config.ts",
        "app-vue/src/main.ts",
        "app-vue/src/**/*.{ts,vue}",
        "tests/**/*.spec.ts"
      ]
    },
    "examples/collaborative-todos": {},
    "examples/chat": {},
    "examples/ai-streaming": {}
  },
  "ignore": ["packages/docs/**", "scripts/rename-to-realtimejs.mjs"]
}
