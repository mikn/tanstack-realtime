{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "@tanstack/react-query",
        "@tanstack/react-db",
        "@tanstack/react-realtime",
        "@tanstack/react-store",
        "react",
        "wrangler"
      ],
      "ignoreBinaries": ["pkg-pr-new"]
    },
    "packages/realtime": {},
    "packages/react-realtime": {},
    "packages/realtime-preset-node": {},
    "packages/realtime-adapter-centrifugo": {},
    "packages/realtime-adapter-sse": {},
    "packages/__tests__": {
      "entry": ["**/*.test.ts"],
      "ignore": ["setup.ts", "workerd-test-worker.ts"]
    },
    "packages/e2e": {
      "entry": ["app/src/main.tsx", "app/vite.config.ts", "tests/**/*.spec.ts"]
    }
  },
  "ignore": ["packages/docs/**", "packages/__tests__/workerd-test-worker.ts"]
}
