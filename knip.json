{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "@tanstack/react-query",
        "@tanstack/react-db",
        "@tanstack/react-realtime",
        "@tanstack/react-store",
        "react"
      ],
      "ignoreBinaries": ["pkg-pr-new"]
    },
    "packages/realtime": {},
    "packages/react-realtime": {},
    "packages/realtime-adapter-centrifugo": {},
    "packages/realtime-adapter-sse": {},
    "packages/__tests__": {
      "entry": ["**/*.test.ts"],
      "ignore": ["setup.ts"]
    },
    "packages/realtime-preset-start": {},
    "packages/e2e": {
      "entry": [
        "app/vite.config.ts",
        "playwright.config.ts",
        "global-setup.ts",
        "global-teardown.ts",
        "app/app/client.tsx",
        "app/app/router.tsx",
        "app/app/routeTree.gen.ts",
        "app/app/routes/**/*.{ts,tsx}",
        "tests/**/*.spec.ts"
      ]
    }
  },
  "ignore": [
    "packages/docs/**",
    "packages/__tests__/workerd-test-worker.ts",
    ".claude/**"
  ]
}
