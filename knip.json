{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "@tanstack/react-query",
        "@tanstack/react-db",
        "@tanstack/react-realtime",
        "@tanstack/react-realtime-devtools",
        "@tanstack/react-store",
        "react"
      ],
      "ignoreBinaries": ["pkg-pr-new"]
    },
    "packages/realtime": {},
    "packages/react-realtime": {},
    "packages/react-realtime-devtools": {},
    "packages/realtime-adapter-centrifugo": {},
    "packages/realtime-adapter-sse": {},
    "packages/__tests__": {
      "entry": ["**/*.test.ts"],
      "ignore": ["setup.ts"]
    },
    "packages/realtime-preset-start": {},
    "packages/e2e": {
      "entry": [
        "app/vite.config.ts",
        "app/app/client.tsx",
        "app/app/router.tsx",
        "app/app/routeTree.gen.ts",
        "app/app/routes/**/*.{ts,tsx}",
        "app-solid/vite.config.ts",
        "app-solid/src/main.tsx",
        "app-solid/src/**/*.{ts,tsx}",
        "app-vue/vite.config.ts",
        "app-vue/src/main.ts",
        "app-vue/src/**/*.{ts,vue}",
        "tests/**/*.spec.ts"
      ]
    }
  },
  "ignore": ["packages/docs/**"]
}
