{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "jsx": "react-jsx",
    "types": ["vitest/globals"],
    "paths": {
      "@realtimejs/core": ["./packages/core/src/index.ts"],
      "@realtimejs/react": ["./packages/react/src/index.ts"],
      "@realtimejs/adapter-centrifugo": [
        "./packages/adapter-centrifugo/src/index.ts"
      ],
      "@realtimejs/adapter-sse": ["./packages/adapter-sse/src/index.ts"],
      "@realtimejs/adapter-pusher": ["./packages/adapter-pusher/src/index.ts"],
      "@realtimejs/adapter-partykit": [
        "./packages/adapter-partykit/src/index.ts"
      ],
      "@realtimejs/adapter-conformance": [
        "./packages/adapter-conformance/src/index.ts"
      ],
      "@realtimejs/preset-start": ["./packages/preset-start/src/index.ts"],
      "@realtimejs/reactive-drizzle": [
        "./packages/reactive-drizzle/src/index.ts"
      ],
      "@realtimejs/react-devtools": ["./packages/react-devtools/src/index.ts"],
      "realtime.js": ["./packages/meta/src/index.ts"]
    }
  },
  "include": [
    "packages/core/src",
    "packages/react/src",
    "packages/react-devtools/src",
    "packages/adapter-centrifugo/src",
    "packages/adapter-sse/src",
    "packages/adapter-pusher/src",
    "packages/adapter-partykit/src",
    "packages/adapter-conformance/src",
    "packages/preset-start/src",
    "packages/reactive-drizzle/src",
    "packages/meta/src",
    "packages/__tests__"
  ],
  "exclude": ["node_modules", "dist", "packages/docs", "examples"]
}
