{
  "name": "@realtimejs/solid",
  "version": "0.0.1",
  "type": "module",
  "description": "Solid primitives and provider for @realtimejs/core",
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@tanstack/db": "*",
    "@realtimejs/core": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": ">=1.0.0"
  },
  "sideEffects": false,
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0"
  }
}
