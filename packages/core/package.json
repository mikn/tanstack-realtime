{
  "name": "@realtimejs/core",
  "version": "0.1.0",
  "description": "Framework-agnostic realtime client, collection helpers, and presence for TanStack DB",
  "type": "module",
  "license": "MIT",
  "author": "mikn",
  "homepage": "https://github.com/mikn/tanstack-realtime#readme",
  "bugs": {
    "url": "https://github.com/mikn/tanstack-realtime/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikn/tanstack-realtime.git",
    "directory": "packages/core"
  },
  "keywords": [
    "realtime",
    "sync",
    "websocket",
    "sse",
    "crdt",
    "presence",
    "tanstack-db"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {},
  "peerDependencies": {
    "@tanstack/db": ">=0.0.1",
    "@tanstack/store": ">=0.0.1"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/db": "^0.5.29",
    "@tanstack/store": "^0.9.1"
  }
}
