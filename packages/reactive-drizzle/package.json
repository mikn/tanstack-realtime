{
  "name": "@realtimejs/reactive-drizzle",
  "version": "0.1.0",
  "description": "Drizzle/Postgres reactive-query engine for @realtimejs/core — auto-derived channels, predicate matching, and invalidation",
  "type": "module",
  "license": "MIT",
  "author": "mikn",
  "homepage": "https://github.com/mikn/realtime.js#readme",
  "bugs": {
    "url": "https://github.com/mikn/realtime.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikn/realtime.js.git",
    "directory": "packages/reactive-drizzle"
  },
  "keywords": [
    "realtime",
    "drizzle",
    "postgres",
    "reactive-query",
    "invalidation"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@realtimejs/core": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "pgsql-ast-parser": "^12.0.0"
  }
}
