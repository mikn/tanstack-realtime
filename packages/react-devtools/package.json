{
  "name": "@realtimejs/react-devtools",
  "version": "0.0.1",
  "type": "module",
  "description": "Developer tools panel for @realtimejs/react",
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@realtimejs/core": "workspace:*",
    "@realtimejs/react": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-store": ">=0.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@tanstack/react-store": "*"
  }
}
