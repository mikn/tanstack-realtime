{
  "name": "@tanstack/realtime-adapter-sse",
  "version": "0.0.1",
  "type": "module",
  "description": "Server-Sent Events (SSE) transport adapter for @tanstack/realtime",
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@tanstack/realtime": "workspace:*",
    "@tanstack/store": "*"
  }
}
