{
  "name": "@tanstack/realtime-preset-start",
  "version": "0.0.1",
  "type": "module",
  "description": "TanStack Start / TanStack Router preset for @tanstack/realtime — transport-agnostic server-side publishing",
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
