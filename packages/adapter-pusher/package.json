{
  "name": "@realtimejs/adapter-pusher",
  "version": "0.1.0",
  "description": "Pusher Channels (and self-hosted Soketi) transport adapter for @realtimejs/core",
  "type": "module",
  "license": "MIT",
  "author": "mikn",
  "homepage": "https://github.com/mikn/tanstack-realtime#readme",
  "bugs": {
    "url": "https://github.com/mikn/tanstack-realtime/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikn/tanstack-realtime.git",
    "directory": "packages/adapter-pusher"
  },
  "keywords": [
    "realtime",
    "pusher",
    "soketi",
    "transport",
    "adapter",
    "websocket"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@realtimejs/core": "workspace:*",
    "@tanstack/store": "^0.9.1",
    "pusher-js": "^8.5.0"
  }
}
