{
  "name": "@realtimejs/adapter-conformance",
  "version": "0.1.0",
  "description": "Conformance test kit that proves a transport adapter satisfies the @realtimejs/core RealtimeTransport contract and declares honest capabilities",
  "type": "module",
  "license": "MIT",
  "author": "mikn",
  "homepage": "https://github.com/mikn/tanstack-realtime#readme",
  "bugs": {
    "url": "https://github.com/mikn/tanstack-realtime/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikn/tanstack-realtime.git",
    "directory": "packages/adapter-conformance"
  },
  "keywords": [
    "realtime",
    "conformance",
    "transport",
    "adapter",
    "testing",
    "vitest"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@realtimejs/core": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=2.0.0"
  }
}
