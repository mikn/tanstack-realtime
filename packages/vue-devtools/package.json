{
  "name": "@realtimejs/vue-devtools",
  "version": "0.1.0",
  "description": "Developer tools panel for @realtimejs/vue",
  "type": "module",
  "license": "MIT",
  "author": "mikn",
  "homepage": "https://github.com/mikn/tanstack-realtime#readme",
  "bugs": {
    "url": "https://github.com/mikn/tanstack-realtime/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikn/tanstack-realtime.git",
    "directory": "packages/vue-devtools"
  },
  "keywords": [
    "realtime",
    "devtools",
    "vue"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@realtimejs/core": "workspace:*",
    "@realtimejs/vue": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  }
}
