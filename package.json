{
  "name": "tanstack-realtime",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "nx run-many --target=build",
    "test": "vitest run --project node",
    "test:watch": "vitest --project node",
    "test:e2e": "vitest run --project centrifugo-e2e",
    "download-centrifugo": "node scripts/download-centrifugo.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.check.json",
    "knip": "knip",
    "size": "size-limit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky",
    "test:playwright": "pnpm --filter @tanstack/realtime-e2e test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@tanstack/db": "^0.5.28",
    "@tanstack/realtime": "workspace:*",
    "@tanstack/react-realtime": "workspace:*",
    "@tanstack/solid-realtime": "workspace:*",
    "@tanstack/realtime-preset-start": "workspace:*",
    "@tanstack/realtime-adapter-centrifugo": "workspace:*",
    "@tanstack/realtime-adapter-sse": "workspace:*",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/react-db": "^0.1.72",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-store": "^0.9.1",
    "@tanstack/store": "^0.9.1",
    "@types/node": "^22.10.10",
    "@types/react": "^19.2.14",
    "@types/ws": "^8.5.13",
    "@vitest/eslint-plugin": "^1.6.9",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "knip": "^5.61.2",
    "nx": "^21.6.2",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "size-limit": "^11.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0",
    "ws": "^8.18.0"
  },
  "size-limit": [
    {
      "name": "@tanstack/realtime",
      "path": "packages/realtime/dist/index.js",
      "limit": "15 kB"
    },
    {
      "name": "@tanstack/react-realtime",
      "path": "packages/react-realtime/dist/index.js",
      "limit": "20 kB",
      "ignore": [
        "@tanstack/realtime",
        "@tanstack/db",
        "@tanstack/store",
        "@tanstack/react-store"
      ]
    },
    {
      "name": "@tanstack/solid-realtime",
      "path": "packages/solid-realtime/dist/index.js",
      "limit": "20 kB",
      "ignore": [
        "@tanstack/realtime",
        "@tanstack/db",
        "solid-js"
      ]
    }
  ]
}
