{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": ["node"],
    "paths": {
      "@realtimejs/react": ["../../packages/react/src/index.ts"],
      "@realtimejs/core": ["../../packages/core/src/index.ts"],
      "@realtimejs/adapter-sse": ["../../packages/adapter-sse/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
